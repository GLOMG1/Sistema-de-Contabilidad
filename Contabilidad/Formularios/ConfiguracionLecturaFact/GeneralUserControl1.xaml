<UserControl x:Class="Contabilidad.Formularios.ConfiguracionLecturaFact.GeneralUserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Contabilidad.Formularios.ConfiguracionLecturaFact"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorPrincipal" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#FFE7D0"/>
        <SolidColorBrush x:Key="ColorAcento" Color="#FC6E20"/>
        <SolidColorBrush x:Key="ColorElevado" Color="#FFFFFF"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ColorElevado}">
        <StackPanel Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Jaime Antonio Espinoza Garcia" 
                           Grid.Row="0"
                           FontSize="25"/>
                <TextBlock Text="Contador" 
                           Grid.Row="1"
                           FontSize="15"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Color Principal"/>

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="5, 5, 5, 0">
                        <TextBox x:Name="txtBoxColorP"
                                 TextChanged="Color_TextChanged"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Margin="5, 1, 5, 2"/>
                    </Border>
                    
                    <Border x:Name="muestraColorP"
                            CornerRadius="5"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Height="200"
                            Margin="5">
                        
                        <TextBlock Text="Color Principal"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Label Content="Color Secundario"/>

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="5, 5, 5, 0">
                        <TextBox x:Name="txtBoxColorS"
                                 TextChanged="Color_TextChanged"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Margin="5, 1, 5, 2"/>
                    </Border>

                    <Border x:Name="muestraColorS"
                            CornerRadius="5"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Height="200"
                            Margin="5">

                        <TextBlock Text="Color Secundario"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Color Acento"/>

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="5, 5, 5, 0">
                        <TextBox x:Name="txtBoxColorA"
                                 TextChanged="Color_TextChanged"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Margin="5, 1, 5, 2"/>
                    </Border>

                    <Border x:Name="muestraColorA"
                            CornerRadius="5"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Height="200"
                            Margin="5">

                        <TextBlock Text="Color de Acento"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <Label Content="Color Elevado"/>

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="5, 5, 5, 0">
                        <TextBox x:Name="txtBoxColorE"
                                 TextChanged="Color_TextChanged"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Margin="5, 1, 5, 2"/>
                    </Border>

                    <Border x:Name="muestraColorE"
                            CornerRadius="5"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Height="200"
                            Margin="5">

                        <TextBlock Text="Color Elevado"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Button Content="Guardar"
                    Click="GuardarColores"
                    HorizontalAlignment="Center"
                    Padding="50, 10, 50, 10"
                    Margin="10"/>
        </StackPanel>
    </Grid>
</UserControl>
