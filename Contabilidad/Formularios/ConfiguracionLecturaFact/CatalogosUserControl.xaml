<UserControl x:Class="Contabilidad.Formularios.ConfiguracionLecturaFact.CatalogosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Contabilidad.Formularios.ConfiguracionLecturaFact"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Wheat">
        <StackPanel>
            <Expander
                Header="Catologo Clave Producto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid 
                        Grid.Column="0"
                        Margin="20">
                        <StackPanel>
                            <TextBlock Text="Añadir nueva clave producto"/>
                            <Label Content="Calve Producto"/>
                            <TextBox />
                            <Label Content="Descripcion"/>
                            <TextBox />
                            <Label Content="Usar clave padre"/>
                            <CheckBox />
                            <Label Content="Cuenta Contable"/>
                            <ComboBox />
                            <Button Content="Añadir"/>
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="0, 10, 10, 20">
                        <ListView>

                        </ListView>
                    </Grid>

                </Grid>
            </Expander>
            <Expander
                Header="Catalogo Cuentas Contables">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Añadir una nueva cuenta contable"/>
                        <Label Content="Nombre de la cuenta"/>
                        <TextBox />
                    </StackPanel>

                    <DataGrid Grid.Column="1">
                        
                    </DataGrid>
                </Grid>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
