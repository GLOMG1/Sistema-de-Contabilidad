<UserControl x:Class="Contabilidad.Formularios.ConfiguracionLecturaFact.ReglasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Contabilidad.Formularios.ConfiguracionLecturaFact"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel>
            <Expander
                Header="Alertas" 
                IsExpanded="True">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Label 
                        Grid.Column="0" 
                        Content="ISR RETENIDO"/>
                    
                    <RadioButton 
                        Grid.Column="2"/>

                </Grid>
            </Expander>

            <Expander
                Header="Reglas de Uso">
                
            </Expander>

            <Expander
                Header="Reglas de Impuestos">
                
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
