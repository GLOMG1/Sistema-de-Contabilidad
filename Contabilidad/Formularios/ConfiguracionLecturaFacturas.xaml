<Window x:Class="Contabilidad.Formularios.ConfiguracionLecturaFacturas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Contabilidad.Formularios"
             mc:Ignorable="d"
             WindowStartupLocation="CenterScreen"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource ColorSecundario}">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorPrincipal" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="ColorSecundario" Color="#FFE7D0"/>
        <SolidColorBrush x:Key="ColorAcento" Color="#FC6E20"/>
        <SolidColorBrush x:Key="ColorElevado" Color="#323232"/>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorSecundario}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{DynamicResource ColorPrincipal}"
                                BorderBrush="{DynamicResource ColorPrincipal}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="10"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource ColorAcento}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ColorSecundario}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource ColorElevado}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ColorSecundario}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Label Content="Barra Pestañas"></Label>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" x:Name="BarraOpciones">
                <StackPanel VerticalAlignment="Center">
                    <RadioButton Content="Vistas"
                                 GroupName="MenuFacturas"/>
                    <RadioButton Content="Reglas"
                                 GroupName="MenuFacturas"/>
                    <RadioButton Content="Catalogos"
                                 GroupName="MenuFacturas"/>
                    <RadioButton Content="General"
                                 GroupName="MenuFacturas"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Background="{DynamicResource ColorElevado}">
                
            </Grid>
        </Grid>
            
    </Grid>
</Window>