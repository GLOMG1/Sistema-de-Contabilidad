<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="Inicio" label="Contabilidad">
			<group id="grpInicio" label="Contribuentes">
				<button label="Iniciar"
						id ="btnIniciar"
						getImage ="GetImage"
						onAction="btnIniciar"
						size="large"/>
				<separator id ="Separador01"/>
				<box id="boxContribuyentes" boxStyle="vertical">
					<button label="Abrir carpeta"
							id="btnAbrirCarpeta"
							onAction="btonAbrirCarpeta"/>
					<button label="Ver contraseñas"
							id="btnVerContraseñas"/>
					<button label="Crear ejercicio"
							id="btnCrearEjercicio"
							onAction="btnCrearEjercicio"/>
				</box>
			</group>
		  
			<group id="grpFacturas" label ="Facturas">
				<button label="Importar"
						id="btnImportar"
						onAction="btnImportar"
						getEnabled="ValidarLibro_GetEnabled"
						getImage="GetImage"
						size="large"/>
				<button label="Guardar en Base de Datos"
						id="btnGuardarBD"
						onAction="btnGuardar"
						getEnabled="ValidarLibro_GetEnabled"
						getImage="GetImage"
						size="large"/>
				<separator id="Separador02"/>
				<button label="Confuguraciones"
						id="btnConfiguracionFacturas"
						onAction="btnConfiguraciones"
						getEnabled="ValidarLibro_GetEnabled"/>
				<button label ="Reportes"
						id="btnReportes"
						getEnabled="ValidarLibro_GetEnabled"/>
				<button label="Descargas"
						id="btnDescargasSAT"
						onAction="btonPruebas"
						getEnabled="ValidarLibro_GetEnabled"
						getImage="GetImage"/>
				<separator id="Separador03"/>
				<button label="DIOT"
						id="btnDiot"
						size="large"
						getImage="GetImage"
						getEnabled="ValidadorLibro_GetEnabled"/>
			</group>
			<group id="grpProveedores" label="Proveedores">
				<button label="Proveedores"
						id="btnProveedores"
						getEnabled="ValidarLibro_GetEnabled"/>
				<button label="Acreedores"
						id="btnAcreedores"
						getEnabled="ValidarLibro_GetEnabled"/>
			</group>

			<group id="grpBancos" label="Bancos">
				<button label ="Importar Estado de Cuenta"
						id ="btnImportarEC"
						getEnabled="ValidarLibro_GetEnabled"
						getImage="GetImage"
						size ="large"/>
				<button label ="Conciliar"
						id="btnConciliar"
						onAction="btnConciliar"
						getEnabled="ValidarLibro_GetEnabled"
						getImage="GetImage"
						size ="large"/>
			</group>

			<group id="grpContabilidad" label="Contabilidad">
				<button label="Polizas"
						onAction="btnPolizas"
						id="btnPolizas"
						size="normal"
						/>
				<button label="Balance General"
						id="btnBalanceGen"
						size="normal"
						/>
				<button label="Configuraciones"
						id="btnConfiguracionesContabilidad"
						size="normal"
					/>
				<separator id="Separador04"/>
				<button label="Catalogo de cuentas"
						id="btnCatalogoCuentas"
						getImage="GetImage"
						size ="large"/>
				<button label ="Evento economico"
						id="btnEventoEco"
						getImage="GetImage"
						size ="large"/>
				<button label="Determinacion de Impuesto"
						id="btnDeterminarImp"
						getImage="GetImage"
						size ="large"/>
			</group>
		  
      </tab>
    </tabs>
  </ribbon>
</customUI>

